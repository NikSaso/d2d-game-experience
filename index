========================================================== */

function getDistrict(){

    if(player.x<1800)
        return "Πυκνό Κέντρο";

    if(player.x<3600)
        return "Παλιό Αθηναϊκό Block";

    if(player.x<5400)
        return "Πλατεία & Αγορά";

    return "Ήσυχο Προάστιο";

}


/* ==========================================================
   PLAYER MOVEMENT
========================================================== */

function updatePlayer(dt){

    if(dialogueOpen)
        return;


    let moving=false;


    if(
        keys["arrowright"] ||
        keys["d"]
    ){

        player.x +=
            player.speed*dt;

        player.direction=1;

        moving=true;

    }


    if(
        keys["arrowleft"] ||
        keys["a"]
    ){

        player.x -=
            player.speed*dt;

        player.direction=-1;

        moving=true;

    }


    player.x =
        Math.max(
            PLAYER_X_MIN,
            Math.min(
                PLAYER_X_MAX,
                player.x
            )
        );


    if(moving){

        player.walkTimer +=
            dt*12;

        player.walkFrame =
            Math.floor(
                player.walkTimer
            )%4;

        player.bob =
            Math.sin(
                player.walkTimer
            )*2;

    }else{

        player.walkFrame=0;

        player.bob=0;

    }


    /*
       Camera smoothly follows.
    */

    const targetCamera =
        player.x -
        canvas.width*.38;


    cameraX +=
        (
            targetCamera -
            cameraX
        )*
        Math.min(
            1,
            dt*7
        );


    cameraX =
        Math.max(
            0,
            Math.min(
                WORLD_WIDTH-
                canvas.width,
                cameraX
            )
        );

}


/* ==========================================================
   NPC MOVEMENT
========================================================== */

function updateNPCs(dt){

    npcs.forEach(
        npc => {

            npc.x +=
                npc.speed*
                npc.direction*
                dt;

            npc.frame +=
                dt*8;


            if(
                npc.x<40
            ){

                npc.x=40;
                npc.direction=1;

            }


            if(
                npc.x>
                WORLD_WIDTH-40
            ){

                npc.x=
                    WORLD_WIDTH-40;

                npc.direction=-1;

            }

        }
    );

}


/* ==========================================================
   CAR MOVEMENT
========================================================== */

function updateCars(dt){

    cars.forEach(
        car => {

            car.x +=
                car.speed*
                car.direction*
                dt;


            if(
                car.direction===1 &&
                car.x>WORLD_WIDTH+300
            ){

                car.x=-300;

            }


            if(
                car.direction===-1 &&
                car.x<-300
            ){

                car.x=
                    WORLD_WIDTH+300;

            }

        }
    );

}


/* ==========================================================
   CLOCK
========================================================== */

function updateClock(dt){

    clockMinutes +=
        dt*1.7;


    if(
        clockMinutes>=
        18*60
    ){

        endGame();

    }

}


/* ==========================================================
   FIND HOUSE
========================================================== */

function getNearbyHouse(){

    let best=null;

    let distance=Infinity;


    houses.forEach(
        house => {

            if(house.visited)
                return;


            const d=
                Math.abs(
                    house.x-
                    player.x
                );


            if(
                d<distance
            ){

                distance=d;

                best=house;

            }

        }
    );


    return {
        house:best,
        distance:distance
    };

}


/* ==========================================================
   INTERACTION
========================================================== */

function tryInteract(){

    const result =
        getNearbyHouse();


    if(
        result.house &&
        result.distance<90
