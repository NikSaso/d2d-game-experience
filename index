<script>

/* =========================================================
   CANVAS
========================================================= */

const canvas =
    document.getElementById("canvas");

const ctx =
    canvas.getContext("2d");

const miniCanvas =
    document.getElementById("miniCanvas");

const miniCtx =
    miniCanvas.getContext("2d");


/* =========================================================
   WORLD
========================================================= */

const WORLD_WIDTH = 7600;

const GROUND_Y = 515;

const ROAD_Y = 575;


/* =========================================================
   GAME STATE
========================================================= */

let gameRunning = false;

let dialogueOpen = false;

let cameraX = 0;

let sales = 0;

let combo = 0;

let energy = 100;

let clockMinutes = 9 * 60;

let lastTime = 0;

let toastTimer = null;


/* =========================================================
   INPUT
========================================================= */

const keys = {};

const justPressed = {};

window.addEventListener("keydown", e => {

    const key = e.key.toLowerCase();

    if (
        e.key === "ArrowUp" ||
        e.key === "ArrowDown" ||
        e.key === "ArrowLeft" ||
        e.key === "ArrowRight" ||
        e.code === "Space"
    ) {
        e.preventDefault();
    }

    if (!keys[key]) {
        justPressed[key] = true;
    }

    if (e.code === "Space" && !keys["space"]) {
        justPressed["space"] = true;
    }

    keys[key] = true;

    if (e.code === "Space") {
        keys["space"] = true;
    }

    if (
        gameRunning &&
        !dialogueOpen &&
        (
            justPressed["arrowup"] ||
            justPressed["w"] ||
            justPressed["space"]
        )
    ) {

        tryDoorOrJump();

    }

});


window.addEventListener("keyup", e => {

    const key = e.key.toLowerCase();

    keys[key] = false;

    if (e.code === "Space") {
        keys["space"] = false;
    }

});


/* =========================================================
   PLAYER
========================================================= */

const player = {

    x: 180,

    y: GROUND_Y,

    vx: 0,

    vy: 0,

    width: 42,

    height: 76,

    speed: 390,

    jumpPower: 720,

    gravity: 1850,

    direction: 1,

    grounded: true,

    walkTimer: 0,

    walkFrame: 0,

    squash: 0

};


/* =========================================================
   CUSTOMER TYPES
========================================================= */

const customerTypes = [

    {
        name: "Ο Θυμωμένος",
        emoji: "😡",

        trust: 20,
        interest: 20,
        need: 45,
        resistance: 80,
        patience: 35,

        intro:
        "Τι θέλετε; Να σας πω από τώρα ότι δεν θέλω να αγοράσω τίποτα."
    },

    {
        name: "Η Ευγενική",
        emoji: "😊",

        trust: 65,
        interest: 45,
        need: 55,
        resistance: 25,
        patience: 80,

        intro:
        "Καλημέρα! Βεβαίως, πείτε μου τι ακριβώς θέλετε."
    },

    {
        name: "Ο Αδιάφορος",
        emoji: "😐",

        trust: 45,
        interest: 15,
        need: 35,
        resistance: 40,
        patience: 50,

        intro:
        "Ναι... πείτε μου. Δεν έχω ασχοληθεί ιδιαίτερα με το ρεύμα."
    },

    {
        name: "Ο Ήρεμος",
        emoji: "😌",

        trust: 60,
        interest: 50,
        need: 55,
        resistance: 25,
        patience: 90,

        intro:
        "Καλησπέρα. Έχω λίγο χρόνο, πείτε μου."
    },

    {
        name: "Ο Πολυλογάς",
        emoji: "🗣️",

        trust: 60,
        interest: 55,
        need: 65,
        resistance: 30,
        patience: 35,

        intro:
        "Αχ, πωλητής! Ξέρετε, πριν χρόνια είχα αλλάξει πάροχο και τότε έγινε κάτι απίστευτο..."
    },

    {
        name: "Ο Δύσπιστος",
        emoji: "🤨",

        trust: 25,
        interest: 65,
        need: 65,
        resistance: 70,
        patience: 65,

        intro:
        "Πριν μου πείτε οτιδήποτε, θέλω συγκεκριμένα πράγματα."
    },

    {
        name: "Ο Κυνηγός Τιμής",
        emoji: "💰",

        trust: 40,
        interest: 70,
        need: 75,
        resistance: 55,
        patience: 55,

        intro:
        "Εμένα με ενδιαφέρει κυρίως πόσα θα πληρώνω."
    },

    {
        name: "Η Οικογένεια",
        emoji: "👨‍👩‍👧",

        trust: 55,
        interest: 50,
        need: 80,
        resistance: 35,
        patience: 70,

        intro:
        "Έχω οικογένεια. Δεν θέλω εκπλήξεις στον λογαριασμό."
    }

];


/* =========================================================
   HOUSES
========================================================= */

const houses = [];

const housePositions = [
    450,
    820,
    1250,
    1710,
    2250,
    2750,
    3180,
    3690,
    4200,
    4670,
    5200,
    5730,
    6250,
    6800,
    7250
];

const houseColors = [
    "#d8a27c",
    "#dfc27b",
    "#b8cbd7",
    "#d5afa2",
    "#b8cfad",
    "#e6d5b5",
    "#c5b6d6"
];

housePositions.forEach((x, i) => {

    houses.push({

        id: i + 1,

        x: x,

        width:
            115 + (i % 3) * 25,

        height:
            150 + (i % 4) * 20,

        floors:
            2 + (i % 4),

        color:
            houseColors[i % houseColors.length],

        customer:
            customerTypes[
                i % customerTypes.length
            ],

        visited: false,

        noAnswer: i % 5 === 0,

        leaflet: null

    });

});


/* =========================================================
   NPCs
========================================================= */

const npcs = [];

for (let i = 0; i < 18; i++) {

    npcs.push({

        x:
            100 +
            Math.random() *
            (WORLD_WIDTH - 200),

        speed:
            15 +
            Math.random() * 30,

        direction:
            Math.random() > .5 ? 1 : -1,

        frame:
            Math.random() * 10,

        color:
            [
                "#d94b4b",
                "#3677c9",
                "#d7a83e",
                "#6a4cb3",
                "#45a35d",
                "#c36c3f"
            ][i % 6]

    });

}


/* =========================================================
   CARS
========================================================= */

const cars = [];

for (let i = 0; i < 14; i++) {

    cars.push({

        x:
            Math.random() *
            WORLD_WIDTH,

        speed:
            45 +
            Math.random() * 70,

        direction:
            i % 2 === 0 ? 1 : -1,

        color:
            [
                "#d64b4b",
                "#3e73bd",
                "#e5b941",
                "#eeeeee",
                "#252b36",
                "#5c9b65"
            ][i % 6]

    });

}


/* =========================================================
   BENCHES / OBSTACLES
========================================================= */

const obstacles = [

    { x: 1030, width: 80, height: 35 },
    { x: 2030, width: 90, height: 30 },
    { x: 3420, width: 80, height: 35 },
    { x: 4900, width: 100, height: 32 },
    { x: 6120, width: 85, height: 34 }

];


/* =========================================================
   START
========================================================= */

function startGame() {

    gameRunning = true;

    document
        .getElementById("startScreen")
        .classList.add("hidden");

    showToast(
        "Ξεκίνα! Πλησίασε ένα σπίτι και πάτησε ↑."
    );

}


/* =========================================================
   DISTRICT
========================================================= */

function getDistrict() {

    if (player.x < 1900)
        return "Πυκνό Κέντρο";

    if (player.x < 3800)
        return "Παλιό Block";

    if (player.x < 5700)
        return "Πλατεία & Αγορά";

    return "Ήσυχο Προάστιο";

}


/* =========================================================
   PLAYER MOVEMENT
========================================================= */

function updatePlayer(dt) {

    if (dialogueOpen)
        return;


    let moving = false;


    /*
       ΠΟΛΥ ΑΜΕΣΗ ΚΙΝΗΣΗ
    */

    if (
        keys["arrowright"] ||
        keys["d"]
    ) {

        player.vx =
            player.speed;

        player.direction = 1;

        moving = true;

    }
    else if (
        keys["arrowleft"] ||
        keys["a"]
    ) {

        player.vx =
            -player.speed;

        player.direction = -1;

        moving = true;

    }
    else {

        /*
           Instant stop για εύκολο gameplay.
        */

        player.vx = 0;

    }


    player.x +=
        player.vx * dt;


    /*
       Gravity
    */

    player.vy +=
        player.gravity * dt;


    player.y +=
        player.vy * dt;


    /*
       Ground collision
    */

    if (
        player.y >= GROUND_Y
    ) {

        player.y =
            GROUND_Y;

        player.vy = 0;

        player.grounded = true;

    }
    else {

        player.grounded = false;

    }


    /*
       Obstacles
    */

    obstacles.forEach(ob => {

        const left =
            ob.x;

        const right =
            ob.x + ob.width;


        const playerLeft =
            player.x - player.width / 2;

        const playerRight =
            player.x + player.width / 2;


        if (
            playerRight > left &&
            playerLeft < right &&
            player.y >= GROUND_Y - ob.height &&
            player.y <= GROUND_Y + 10 &&
            player.vy >= 0
        ) {

            player.y =
                GROUND_Y - ob.height;

            player.vy = 0;

            player.grounded = true;

        }

    });


    player.x =
        Math.max(
            35,
            Math.min(
                WORLD_WIDTH - 35,
                player.x
            )
        );


    /*
       Animation
    */

    if (moving && player.grounded) {

        player.walkTimer +=
            dt * 13;

        player.walkFrame =
            Math.floor(
                player.walkTimer
            ) % 4;

    }
    else {

        player.walkFrame = 0;

    }


    /*
       Smooth camera
    */

    const targetCamera =
        player.x -
        canvas.width * .38;


    cameraX +=
        (
            targetCamera -
            cameraX
        ) *
        Math.min(
            1,
            dt * 8
        );


    cameraX =
        Math.max(
            0,
            Math.min(
                WORLD_WIDTH -
                canvas.width,
                cameraX
            )
        );

}


/* =========================================================
   JUMP / DOOR
========================================================= */

function tryDoorOrJump() {

    const result =
        getNearbyHouse();


    /*
       If close to house:
       open / knock.
    */

    if (
        result.house &&
        result.distance < 105
    ) {

        knockDoor(
            result.house
        );

        return;

    }


    /*
       Otherwise jump.
    */

    if (player.grounded) {

        player.vy =
            -player.jumpPower;

        player.grounded = false;

    }

}


/* =========================================================
   HOUSE DETECTION
========================================================= */

function getNearbyHouse() {

    let nearest = null;

    let distance = Infinity;


    houses.forEach(house => {

        if (house.visited)
            return;


        const d =
            Math.abs(
                house.x -
                player.x
            );


        if (d < distance) {

            distance = d;

            nearest = house;

        }

    });


    return {

        house: nearest,

        distance: distance

    };

}


/* =========================================================
   KNOCK DOOR
========================================================= */

function knockDoor(house) {

    if (dialogueOpen)
        return;


    /*
       Some customers do not answer.
    */

    if (house.noAnswer) {

        leaveLeaflet(house);

        return;

