<script>

/* ==========================================================
   CANVAS
========================================================== */

const canvas =
    document.getElementById("canvas");

const ctx =
    canvas.getContext("2d");

const miniCanvas =
    document.getElementById("miniCanvas");

const miniCtx =
    miniCanvas.getContext("2d");


/* ==========================================================
   WORLD
========================================================== */

const WORLD_WIDTH = 7200;

const GROUND_Y = 515;

const PLAYER_X_MIN = 30;

const PLAYER_X_MAX =
    WORLD_WIDTH - 30;


/* ==========================================================
   GAME
========================================================== */

let gameRunning = false;

let dialogueOpen = false;

let cameraX = 0;

let sales = 0;

let combo = 0;

let bestCombo = 0;

let energy = 100;

let clockMinutes = 9 * 60;

let lastTime = 0;

let toastTimer = null;


/* ==========================================================
   INPUT
========================================================== */

const keys = {};

window.addEventListener(
    "keydown",
    e => {

        const key =
            e.key.toLowerCase();

        keys[key] = true;

        if(
            key === " " ||
            e.code === "Space"
        ){
            e.preventDefault();
        }

        if(
            gameRunning &&
            !dialogueOpen &&
            (
                key === "arrowup" ||
                key === "w" ||
                e.code === "Space"
            )
        ){

            tryInteract();

        }

    }
);

window.addEventListener(
    "keyup",
    e => {

        keys[
            e.key.toLowerCase()
        ] = false;

    }
);


/* ==========================================================
   PLAYER
========================================================== */

const player = {

    x:220,

    y:GROUND_Y,

    vx:0,

    width:34,

    height:64,

    speed:270,

    direction:1,

