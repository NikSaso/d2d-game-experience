    */

    if(house.plants){

        ctx.fillStyle=
            "#5b4435";


        ctx.fillRect(
            x+5,
            bottom-38,
            12,
            25
        );


        ctx.fillStyle=
            "#3b9b55";


        ctx.fillRect(
            x,
            bottom-48,
            23,
            16
        );

    }


    /*
       customer indicator
    */

    if(
        !house.visited
    ){

        ctx.fillStyle=
            "#ffffff";


        ctx.fillRect(
            x+
            house.width/2-
            20,
            bottom-
            house.height-
            35,
            40,
            24
        );


        ctx.fillStyle=
            "#111827";


        ctx.font=
            "18px Arial";


        ctx.textAlign=
            "center";


        ctx.fillText(
            house.customer.emoji,
            x+
            house.width/2,
            bottom-
            house.height-
            17
        );


        ctx.textAlign=
            "left";

    }

}


/* ==========================================================
   DRAW CARS
========================================================== */

function drawCar(car){

    const x =
        car.x-
        cameraX;


    const y =
        535;


    if(
        x<-120 ||
        x>canvas.width+120
    )
        return;


    /*
       shadow
    */

    ctx.fillStyle=
        "rgba(0,0,0,.2)";


    ctx.fillRect(
        x-34,
        y+31,
        68,
        6
    );


    /*
       body
    */

    ctx.fillStyle=
        car.color;


    ctx.fillRect(
        x-38,
        y,
        76,
        27
    );


    /*
       cabin
    */

    ctx.fillStyle=
        car.color;


    ctx.fillRect(
        x-22,
        y-17,
        44,
        18
    );


    /*
       windows
    */

    ctx.fillStyle=
        "#7ab4c8";


    ctx.fillRect(
        x-17,
        y-13,
        15,
        11
    );


    ctx.fillRect(
        x+3,
        y-13,
        15,
        11
    );


    /*
       wheels
    */

    ctx.fillStyle=
        "#171b22";


    ctx.fillRect(
        x-28,
        y+20,
        13,
        13
    );


    ctx.fillRect(
        x+15,
        y+20,
        13,
        13
    );

}


/* ==========================================================
   DRAW NPC
========================================================== */

function drawNPC(npc){

    const x =
        npc.x-
        cameraX;


    const y =
        555;


    if(
        x<-50 ||
        x>canvas.width+50
    )
        return;


    const step =
        Math.sin(
            npc.frame
        )*5;


    /*
       shadow
    */

    ctx.fillStyle=
        "rgba(0,0,0,.22)";


    ctx.fillRect(
        x-13,
        y+35,
        26,
        5
    );


    /*
       legs
    */

    ctx.strokeStyle=
        "#283342";

    ctx.lineWidth=6;


    ctx.beginPath();

    ctx.moveTo(
        x-5,
        y+15
    );

    ctx.lineTo(
        x-7+step,
        y+35
    );


    ctx.moveTo(
        x+5,
        y+15
    );

    ctx.lineTo(
        x+7-step,
        y+35
    );


    ctx.stroke();


    /*
       body
    */

    ctx.fillStyle=
        npc.color;


    ctx.fillRect(
        x-12,
        y-18,
        24,
        34
    );


    /*
       head
    */

    ctx.fillStyle=
        "#eab48c";


    ctx.fillRect(
        x-9,
        y-39,
        18,
        18
    );


    /*
       hair
    */

    ctx.fillStyle=
        "#4a3227";


    ctx.fillRect(
        x-9,
        y-41,
        18,
        7
    );

}


/* ==========================================================
   DRAW PLAYER
========================================================== */

function drawPlayer(){

    const x =
        canvas.width*.38;


    const baseY =
        GROUND_Y;


    const y =
        baseY+
        player.bob;


    /*
       shadow
    */

    ctx.fillStyle=
        "rgba(0,0,0,.30)";


    ctx.fillRect(
        x-22,
        y+2,
        44,
        7
    );


    /*
       walking legs
    */

    const leg =
        player.walkFrame===1
            ?5
            :player.walkFrame===3
                ?-5
                :0;


    ctx.strokeStyle=
        "#1b2433";

    ctx.lineWidth=9;


    ctx.beginPath();

    ctx.moveTo(
        x-8,
        y-5
    );

    ctx.lineTo(
        x-10+leg,
        y+25
    );


    ctx.moveTo(
        x+8,
        y-5
    );

    ctx.lineTo(
        x+10-leg,
        y+25
    );


    ctx.stroke();


    /*
       shoes
    */

    ctx.fillStyle=
        "#171b22";


    ctx.fillRect(
        x-20+leg,
        y+21,
        17,
        7
    );


    ctx.fillRect(
        x+3-leg,
        y+21,
        17,
        7
    );


    /*
       body / shirt
    */

    ctx.fillStyle=
        "#147dcc";


    ctx.fillRect(
        x-19,
        y-55,
        38,
        51
    );


    /*
       white company panel
    */

    ctx.fillStyle=
        "#ffffff";


    ctx.fillRect(
        x-12,
        y-42,
        24,
        12
    );


    ctx.fillStyle=
        "#147dcc";


    ctx.font=
        "bold 8px Arial";

    ctx.textAlign=
        "center";


    ctx.fillText(
        "D2D",
        x,
        y-33
    );


    /*
       arms
    */

    ctx.strokeStyle=
        "#eab48c";

    ctx.lineWidth=7;


    ctx.beginPath();

    ctx.moveTo(
        x-18,
        y-43
    );

    ctx.lineTo(
        x-27,
        y-15-leg
    );


    ctx.moveTo(
        x+18,
        y-43
    );

    ctx.lineTo(
        x+27,
        y-15+leg
    );


    ctx.stroke();


    /*
       head
    */

    ctx.fillStyle=
        "#eab48c";


    ctx.fillRect(
        x-15,
        y-75,
        30,
        28
    );


    /*
       hair
    */

    ctx.fillStyle=
        "#39271f";


    ctx.fillRect(
        x-15,
        y-79,
        30,
        10
    );


    /*
       ear
    */

    ctx.fillStyle=
        "#d89a76";


    ctx.fillRect(
        x-17,
        y-67,
        4,
        9
    );


    /*
       bag
    */

    ctx.fillStyle=
        "#28384d";


    ctx.fillRect(
        x+18,
        y-37,
        24,
        34
    );


    ctx.textAlign=
        "left";

}


/* ==========================================================
   DRAW STREET DETAILS
========================================================== */

function drawStreetDetails(){

    /*
       Lamps
    */

    for(
        let wx=
            300-
            (cameraX*.7)%600;
        wx<
            canvas.width+500;
        wx+=600
    ){

        ctx.fillStyle=
            "#343b45";


        ctx.fillRect(
            wx,
            405,
            5,
            95
        );


        ctx.fillRect(
            wx-15,
            405,
            35,
            5
        );


        ctx.fillStyle=
            "#f3df91";


        ctx.fillRect(
            wx-10,
            410,
            25,
            8
        );

    }


    /*
       Trees
    */

    for(
        let wx=
            80-
            (cameraX*.8)%320;
        wx<
            canvas.width+400;
        wx+=320
    ){

        ctx.fillStyle=
            "#5b4430";


        ctx.fillRect(
            wx,
            455,
            10,
            55
        );


        ctx.fillStyle=
            "#3c914d";


        ctx.fillRect(
            wx-16,
            430,
            42,
            30
        );


        ctx.fillRect(
            wx-8,
            415,
            27,
            30
        );

    }


    /*
       Utility wires
    */

    ctx.strokeStyle=
        "#354553";

    ctx.lineWidth=2;


    ctx.beginPath();

    ctx.moveTo(
        0,
        270
    );

    ctx.quadraticCurveTo(
        canvas.width/2,
        320,
        canvas.width,
        270
    );

    ctx.stroke();

}


/* ==========================================================
   DRAW MINIMAP
========================================================== */

function drawMiniMap(){

    miniCtx.clearRect(
        0,
        0,
        miniCanvas.width,
        miniCanvas.height
    );


    /*
       world
    */

    miniCtx.fillStyle=
        "#548d54";


    miniCtx.fillRect(
        0,
        0,
        miniCanvas.width,
        miniCanvas.height
    );


    /*
       road
    */

    miniCtx.fillStyle=
        "#454b54";


    miniCtx.fillRect(
        0,
        76,
        miniCanvas.width,
        45
    );


    /*
       houses
    */

    houses.forEach(
        house => {

            const x =
                house.x/
                WORLD_WIDTH*
                miniCanvas.width;


            miniCtx.fillStyle=
                house.visited
                    ?"#666"
                    :"#e4bd68";


            miniCtx.fillRect(
                x,
                54,
                10,
                8
            );

        }
    );


    /*
       player
    */

    const px =
        player.x/
        WORLD_WIDTH*
        miniCanvas.width;


    miniCtx.fillStyle=
        "#fff";


    miniCtx.fillRect(
        px-3,
        91,
        7,
        13
    );


    /*
       camera
    */

    const viewWidth =
        canvas.width/
        WORLD_WIDTH*
        miniCanvas.width;


    const viewX =
        cameraX/
        WORLD_WIDTH*
        miniCanvas.width;


    miniCtx.strokeStyle=
        "#ffffff";


    miniCtx.lineWidth=2;


    miniCtx.strokeRect(
        viewX,
        2,
        viewWidth,
        144
    );

}


/* ==========================================================
   DRAW
========================================================== */

function draw(){

    drawSky();

    drawGround();


    /*
       Background city.
    */

    /*
       Buildings.
    */

    houses
        .forEach(
            drawBuilding
        );


    drawStreetDetails();


    /*
       Cars behind player.
    */

    cars.forEach(
        drawCar
    );


    /*
       Pedestrians.
    */

    npcs.forEach(
        drawNPC
    );


    /*
       Player always last.
    */

    drawPlayer();


    drawMiniMap();

}


/* ==========================================================
   UPDATE
========================================================== */

function update(dt){

    if(!gameRunning)
        return;


    updatePlayer(dt);

    updateNPCs(dt);

    updateCars(dt);

    updateClock(dt);

    updatePrompt();

    updateHUD();

}


/* ==========================================================
   END GAME
========================================================== */

function endGame(){

    if(!gameRunning)
        return;


    gameRunning=false;

    dialogueOpen=false;


    document
        .getElementById("dialog")
        .style.display="none";


    document
        .getElementById("prompt")
        .style.display="none";


    document
        .getElementById("finalSales")
        .textContent=
        sales;


    let text="";


    if(
        sales>=10
    ){

        text=
        "🔥 Έπιασες τον ημερήσιο στόχο! Πολύ καλή δουλειά.";

    }
    else if(
        energy<=0
    ){

        text=
        "⚡ Η ενέργειά σου τελείωσε. Την επόμενη ημέρα χρειάζεται καλύτερη διαχείριση.";

    }
    else{

        text=
        "Καλή προσπάθεια. Κάθε πόρτα είναι διαφορετική.";

    }


    document
        .getElementById("finalText")
        .textContent=
        text;


    document
        .getElementById("endScreen")
        .classList.remove("hidden");

}


/* ==========================================================
   GAME LOOP
========================================================== */

function gameLoop(timestamp){

    const dt =
        Math.min(
            .033,
            (timestamp-lastTime)/
            1000
        );


    lastTime=timestamp;


    update(dt);

    draw();


    requestAnimationFrame(
        gameLoop
    );

}


/* ==========================================================
   INIT
========================================================== */

updateHUD();

requestAnimationFrame(
    gameLoop
);

</script>

