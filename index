/* ==========================================================
   DRAW SKY
========================================================== */

function drawSky(){

    ctx.fillStyle=
        "#73c9ef";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    /*
       Clouds
    */

    ctx.fillStyle=
        "#dff5ff";


    for(
        let i=0;
        i<9;
        i++
    ){

        const x =
            (
                i*240-
                cameraX*.15
            )%
            1500;


        const xx =
            x<0
                ?x+1500
                :x;


        const y =
            80+
            (i%3)*35;


        ctx.fillRect(
            xx,
            y,
            55,
            14
        );

        ctx.fillRect(
            xx+15,
            y-10,
            38,
            22
        );

        ctx.fillRect(
            xx+40,
            y+2,
            48,
            12
        );

    }


    /*
       distant city
    */

    ctx.fillStyle=
        "#718796";


    backgroundBuildings.forEach(
        b => {

            const x =
                b.x-cameraX*.32;


            if(
                x+b.width<0 ||
                x>canvas.width
            )
                return;


            ctx.fillRect(
                x,
                300-b.height*.45,
                b.width,
                b.height
            );


            /*
               tiny windows
            */

            ctx.fillStyle=
                "#d8d8a1";


            for(
                let yy=
                    315-b.height*.45;
                yy<
                    300+b.height*.45;
                yy+=22
            ){

                for(
                    let xx=
                        x+12;
                    xx<
                        x+b.width-10;
                    xx+=24
                ){

                    ctx.fillRect(
                        xx,
                        yy,
                        8,
                        8
                    );

                }

            }


            ctx.fillStyle=
                "#718796";

        }
    );

}


