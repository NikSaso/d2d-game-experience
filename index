/* =========================================================
   OBSTACLES
========================================================= */

function drawObstacles() {

    obstacles.forEach(ob => {

        const x =
            ob.x -
            cameraX;


        if (
            x < -150 ||
            x > canvas.width + 150
        )
            return;


        /*
           bench
        */

        ctx.fillStyle =
            "#5b3d2e";


        ctx.fillRect(
            x,
            GROUND_Y - ob.height,
            ob.width,
            9
        );


        ctx.fillRect(
            x + 10,
            GROUND_Y - ob.height + 9,
            8,
            25
        );


        ctx.fillRect(
            x + ob.width - 18,
            GROUND_Y - ob.height + 9,
            8,
            25
        );

    });

}


/* =========================================================
   CARS
========================================================= */

function drawCar(car) {

    const x =
        car.x -
        cameraX;


    const y =
        535;


    if (
        x < -120 ||
        x > canvas.width + 120
    )
        return;


    /*
       shadow
    */

    ctx.fillStyle =
        "rgba(0,0,0,.25)";


    ctx.fillRect(
        x - 40,
        y + 30,
        80,
        7
    );


    /*
       body
    */

    ctx.fillStyle =
        car.color;


    ctx.fillRect(
        x - 42,
        y,
        84,
        28
    );


    /*
       cabin
    */

    ctx.fillRect(
        x - 24,
        y - 18,
        48,
        19
    );


    /*
       windows
    */

    ctx.fillStyle =
        "#78b7cb";


    ctx.fillRect(
        x - 19,
        y - 14,
        17,
        12
    );


    ctx.fillRect(
        x + 3,
        y - 14,
        17,
        12
    );


    /*
       wheels
    */

    ctx.fillStyle =
        "#161a20";


    ctx.fillRect(
        x - 30,
        y + 20,
        15,
        14
    );


    ctx.fillRect(
        x + 15,
        y + 20,
        15,
        14
    );

}


/* =========================================================
   NPC
========================================================= */

function drawNPC(npc) {

    const x =
        npc.x -
        cameraX;


    const y =
        555;


    if (
        x < -60 ||
        x > canvas.width + 60
    )
        return;


    const step =
        Math.sin(
            npc.frame
        ) * 5;


    /*
       shadow
    */

    ctx.fillStyle =
        "rgba(0,0,0,.22)";


    ctx.fillRect(
        x - 14,
        y + 34,
        28,
        5
    );


    /*
       legs
    */

    ctx.strokeStyle =
        "#293342";

    ctx.lineWidth = 6;


    ctx.beginPath();

    ctx.moveTo(
        x - 5,
        y + 14
    );

    ctx.lineTo(
        x - 7 + step,
        y + 35
    );


    ctx.moveTo(
        x + 5,
        y + 14
    );

    ctx.lineTo(
        x + 7 - step,
        y + 35
    );

    ctx.stroke();


    /*
       body
    */

    ctx.fillStyle =
        npc.color;


    ctx.fillRect(
        x - 12,
        y - 18,
        24,
        34
    );


    /*
       head
    */

    ctx.fillStyle =
        "#e9b28b";


    ctx.fillRect(
        x - 9,
        y - 40,
        18,
        19
    );


    /*
       hair
    */

    ctx.fillStyle =
        "#493127";


    ctx.fillRect(
        x - 9,
        y - 42,
        18,
        7
    );

}


/* =========================================================
   PLAYER DRAW
========================================================= */

function drawPlayer() {

    /*
       IMPORTANT:
       Player is drawn LAST,
       therefore always clearly visible.
    */

    const x =
        canvas.width * .38;


    const y =
        player.y;


    /*
       Shadow
    */

    ctx.fillStyle =
        "rgba(0,0,0,.35)";


    ctx.fillRect(
        x - 25,
        GROUND_Y + 4,
        50,
        8
    );


    /*
       Backpack shadow
    */

    ctx.fillStyle =
        "#26394d";


    ctx.fillRect(
        x + 17,
        y - 50,
        22,
        48
    );


    /*
       Legs
    */

    const leg =
        player.grounded
            ? (
                player.walkFrame === 1
                    ? 6
                    : player.walkFrame === 3
                        ? -6
                        : 0
            )
            : 0;


    ctx.strokeStyle =
        "#172235";

    ctx.lineWidth = 10;


    ctx.beginPath();

    ctx.moveTo(
        x - 9,
        y - 7
    );

    ctx.lineTo(
        x - 12 + leg,
        y + 25
    );


    ctx.moveTo(
        x + 9,
        y - 7
    );

    ctx.lineTo(
        x + 12 - leg,
        y + 25
    );


    ctx.stroke();


    /*
       Shoes
    */

    ctx.fillStyle =
        "#111827";


    ctx.fillRect(
        x - 22 + leg,
        y + 21,
        19,
        8
    );


    ctx.fillRect(
        x + 3 - leg,
        y + 21,
        19,
        8
    );


    /*
       BODY
    */

    ctx.fillStyle =
        "#167dcc";


    ctx.fillRect(
        x - 21,
        y - 61,
        42,
        55
    );


    /*
       White shirt panel
    */

    ctx.fillStyle =
        "#ffffff";


    ctx.fillRect(
        x - 14,
        y - 46,
        28,
        16
    );


    ctx.fillStyle =
        "#167dcc";


    ctx.font =
        "bold 10px Arial";

    ctx.textAlign =
        "center";


    ctx.fillText(
        "D2D",
        x,
        y - 34
    );


    /*
       Belt
    */

    ctx.fillStyle =
        "#263444";


    ctx.fillRect(
        x - 21,
        y - 11,
        42,
        7
    );


    /*
       ARMS
    */

    ctx.strokeStyle =
        "#eab48c";

    ctx.lineWidth = 8;


    /*
       Left arm
    */

    ctx.beginPath();

    ctx.moveTo(
        x - 19,
        y - 48
    );

    ctx.lineTo(
        x - 30,
        y - 18 + leg
    );

    ctx.stroke();


    /*
       Right arm
    */

    ctx.beginPath();

    ctx.moveTo(
        x + 19,
        y - 48
    );

    ctx.lineTo(
        x + 31,
        y - 18 - leg
    );

    ctx.stroke();


    /*
       Hand
    */

    ctx.fillStyle =
        "#eab48c";


    ctx.fillRect(
        x - 34,
        y - 22 + leg,
        9,
        9
    );


    ctx.fillRect(
        x + 26,
        y - 22 - leg,
        9,
        9
    );


    /*
       HEAD
    */

    ctx.fillStyle =
        "#eab48c";


    ctx.fillRect(
        x - 17,
        y - 86,
        34,
        31
    );


    /*
       Ears
    */

    ctx.fillRect(
        x - 20,
        y - 76,
        5,
        10
    );


    ctx.fillRect(
        x + 15,
        y - 76,
        5,
        10
    );


    /*
       Hair
    */

    ctx.fillStyle =
        "#39271f";


    ctx.fillRect(
        x - 17,
        y - 91,
        34,
        11
    );


    ctx.fillRect(
        x - 13,
        y - 96,
        26,
        7
    );


    /*
       Eyes
    */

    ctx.fillStyle =
        "#172235";


    ctx.fillRect(
        x - 9,
        y - 73,
        4,
        4
    );


    ctx.fillRect(
        x + 5,
        y - 73,
        4,
        4
    );


    /*
       Smile
    */

    ctx.fillRect(
        x - 4,
        y - 63,
        9,
        2
    );


    /*
       HIGHLIGHT OUTLINE
       Makes player extremely easy to see.
    */

    ctx.strokeStyle =
        "#fff";

    ctx.lineWidth = 2;


    ctx.strokeRect(
        x - 23,
        y - 63,
        46,
        58
    );


    ctx.textAlign =
        "left";


    /*
       Leaflet in hand when near no-answer
       house.
    */

    const nearby =
        getNearbyHouse();


    if (
        nearby.house &&
        nearby.distance < 115 &&
        nearby.house.noAnswer
    ) {

        drawPlayerLeaflet(
            x + 36,
            y - 42
        );

    }

}


/* =========================================================
   PLAYER LEAFLET
========================================================= */

function drawPlayerLeaflet(x, y) {

    ctx.fillStyle =
        "#fff8d8";


    ctx.fillRect(
        x,
        y,
