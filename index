/* =========================================================
   APPLY EFFECTS
========================================================= */

function applyEffects(effects) {

    Object.keys(effects).forEach(key => {

        session[key] +=
            effects[key];


        session[key] =
            Math.max(
                0,
                Math.min(
                    100,
                    session[key]
                )
            );

    });

}


/* =========================================================
   CLOSING PROBABILITY
========================================================= */

function closingProbability() {

    let p =

        session.trust * .27 +

        session.interest * .23 +

        session.need * .25 +

        session.patience * .10 +

        (100 -
        session.resistance) * .15;


    if (
        session.trust > 70 &&
        session.interest > 65
    ) {

        p += 8;

    }


    if (
        session.need > 75 &&
        session.resistance < 30
    ) {

        p += 9;

    }


    return Math.max(
        3,
        Math.min(
            95,
            p
        )
    );

}


/* =========================================================
   SELECT CHOICE
========================================================= */

function selectChoice(choice) {

    applyEffects(
        choice.effects
    );


    session.turns++;


    session.patience -=
        session.turns;


    if (choice.close) {

        finishSale(
            choice
        );

        return;

    }


    session.stage =
        choice.next;


    renderDialogue();

}


/* =========================================================
   FINISH SALE
========================================================= */

function finishSale(choice) {

    const probability =
        closingProbability();


    let success =
        Math.random() * 100 <
        probability;


    if (
        choice.soft &&
        probability < 50
    ) {

        success = false;

    }


    session.house.visited =
        true;


    dialogueOpen =
        false;


    document
        .getElementById("dialog")
        .style.display =
        "none";


    if (success) {

        sales++;

        combo++;

        energy =
            Math.min(
                100,
                energy + 8
            );


        showToast(
            "🎉 ΠΩΛΗΣΗ! " +
            Math.round(
                probability
            ) +
            "% πιθανότητα"
        );

    }
    else {

        combo = 0;

        energy =
            Math.max(
                0,
                energy - 8
            );


        showToast(
            "❌ Δεν έκλεισε. " +
            Math.round(
                probability
            ) +
            "% πιθανότητα"
        );

    }


    updateHUD();


    if (
        sales >= 10 ||
        energy <= 0
    ) {

        setTimeout(
            endGame,
            900
        );

    }

}


