/* =========================================================
   NPC UPDATE
========================================================= */

function updateNPCs(dt) {

    npcs.forEach(npc => {

        npc.x +=
            npc.speed *
            npc.direction *
            dt;


        npc.frame +=
            dt * 8;


        if (
            npc.x < 40
        ) {

            npc.x = 40;

            npc.direction = 1;

        }


        if (
            npc.x >
            WORLD_WIDTH - 40
        ) {

            npc.x =
                WORLD_WIDTH - 40;

            npc.direction = -1;

        }

    });

}


/* =========================================================
   CAR UPDATE
========================================================= */

function updateCars(dt) {

    cars.forEach(car => {

        car.x +=
            car.speed *
            car.direction *
            dt;


        if (
            car.direction === 1 &&
            car.x >
            WORLD_WIDTH + 300
        ) {

            car.x = -300;

        }


        if (
            car.direction === -1 &&
            car.x < -300
        ) {

            car.x =
                WORLD_WIDTH + 300;

        }

    });

}


/* =========================================================
   CLOCK
========================================================= */

function updateClock(dt) {

    clockMinutes +=
        dt * 1.7;


    if (
        clockMinutes >=
        18 * 60
    ) {

        endGame();

    }

}


/* =========================================================
   SKY
========================================================= */

function drawSky() {

    ctx.fillStyle =
        "#78cbed";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    /*
       Sun
    */

    ctx.fillStyle =
        "#ffe38a";

    ctx.fillRect(
        1050 - cameraX * .08,
        100,
        60,
        60
    );


    /*
       Clouds
    */

    ctx.fillStyle =
        "#e8f7ff";


    for (
        let i = 0;
        i < 10;
        i++
    ) {

        let x =
            (
                i * 270 -
                cameraX * .15
            ) % 1700;


        if (x < 0)
            x += 1700;


        const y =
            70 +
            (i % 3) * 35;


        ctx.fillRect(
            x,
            y,
            70,
            13
        );

        ctx.fillRect(
            x + 15,
            y - 10,
            42,
            23
        );

        ctx.fillRect(
            x + 45,
            y + 1,
            40,
            12
        );

    }


    /*
       Distant city
    */

    const buildings = 60;


    for (
        let i = 0;
        i < buildings;
        i++
    ) {

        const x =
            i * 145 -
            cameraX * .32;


        const width =
            95 +
            (i % 3) * 25;


        const height =
            120 +
            (i % 5) * 30;


        if (
            x + width < 0 ||
            x > canvas.width
        )
            continue;


        ctx.fillStyle =
            [
                "#8da2b1",
                "#9aaab5",
                "#ad9f97",
                "#8399a9"
            ][i % 4];


        ctx.fillRect(
            x,
            420 - height,
            width,
            height
        );


        ctx.fillStyle =
            "#d9d39a";


        for (
            let wy =
                440 - height;
            wy < 420;
            wy += 25
        ) {

            for (
                let wx =
                    x + 15;
                wx < x + width - 10;
                wx += 25
            ) {

                ctx.fillRect(
                    wx,
                    wy,
                    8,
                    8
                );

            }

        }

    }

}


