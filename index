    );


    ctx.strokeStyle =
        "#24344f";

    ctx.lineWidth = 2;


    ctx.strokeRect(
        x,
        y,
        42,
        30
    );


    ctx.fillStyle =
        "#167dcc";


    ctx.fillRect(
        x + 4,
        y + 4,
        34,
        6
    );


    ctx.fillStyle =
        "#24344f";


    ctx.font =
        "bold 5px Arial";


    ctx.fillText(
        "ΕΝΕΡΓΕΙΑ",
        x + 7,
        y + 9
    );


    ctx.font =
        "5px Arial";


