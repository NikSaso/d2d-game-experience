<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>D2D ΔΕΗ - 16 Bit Sales Adventure</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #111827;
    font-family: Arial, sans-serif;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
}

#game {
    position: relative;
    width: 1280px;
    height: 720px;
    overflow: hidden;
    background: #78cbed;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
}

/* =====================================================
   HUD
===================================================== */

#hud {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    height: 64px;

    display: flex;
    align-items: center;
    gap: 8px;

    z-index: 30;
    pointer-events: none;
}

.hudBox {
    background: #172235;
    border: 3px solid #08101d;
    box-shadow: 4px 4px 0 rgba(0,0,0,.35);

    color: white;

    min-height: 44px;
    padding: 8px 12px;

    display: flex;
    align-items: center;
    gap: 7px;

    font-size: 14px;
    font-weight: bold;
}

#energyBox {
    min-width: 165px;
}

#energyBar {
    width: 80px;
    height: 13px;

    border: 2px solid #08101d;
    background: #3a4658;
}

#energyFill {
    width: 100%;
    height: 100%;
    background: #39d353;
}

/* =====================================================
   PROMPT
===================================================== */

#prompt {
    position: absolute;

    left: 50%;
    bottom: 100px;

    transform: translateX(-50%);

    z-index: 35;

    background: #fff4b8;
    border: 4px solid #101722;
    box-shadow: 5px 5px 0 rgba(0,0,0,.4);

    padding: 10px 18px;

    color: #101722;
    font-size: 16px;
    font-weight: bold;

    display: none;
}

/* =====================================================
   TOAST
===================================================== */

#toast {
    position: absolute;

    top: 90px;
    left: 50%;

    transform: translateX(-50%);

    z-index: 90;

    background: #172235;
    color: white;

    border: 3px solid #05090f;
    box-shadow: 4px 4px 0 rgba(0,0,0,.4);

    padding: 10px 20px;

    font-size: 15px;
    font-weight: bold;

    display: none;
}

/* =====================================================
   DIALOG
===================================================== */

#dialog {
    position: absolute;

    left: 50%;
    bottom: 12px;

    transform: translateX(-50%);

    width: 920px;
    max-width: 92%;

    background: #f7f0dc;

    border: 5px solid #151e2d;
    box-shadow: 7px 7px 0 rgba(0,0,0,.45);

    z-index: 70;

    display: none;
}

#dialogHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;

    background: #263852;
    color: white;

    padding: 8px 12px;
}

#customerName {
    font-size: 18px;
    font-weight: bold;
}

#stage {
    background: #f3c943;
    color: #172235;

    padding: 5px 9px;

    font-size: 11px;
    font-weight: bold;
}

#customerSpeech {
    min-height: 62px;

    padding: 12px 15px;

    color: #202a39;

    font-size: 16px;
    line-height: 1.4;
}

#salesStats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;

    padding: 0 12px 10px;
}

.stat {
    color: #2d394b;

    font-size: 10px;
    font-weight: bold;
}

.bar {
    height: 8px;

    margin-top: 3px;

    background: #c9ced6;
    border: 1px solid #8c96a5;
}

.fill {
    width: 50%;
    height: 100%;

    background: #2878d7;
}

#choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;

    padding: 0 12px 12px;
}

.choice {
    min-height: 62px;

    border: 3px solid #273449;

    background: #e3e8ee;
    color: #172033;

    padding: 8px 10px;

    cursor: pointer;

    text-align: left;

    font-size: 13px;
    font-weight: bold;

    box-shadow: 3px 3px 0 rgba(0,0,0,.25);
}

.choice:hover {
    background: #cfe6ff;
    transform: translate(-1px,-1px);
}

.choice small {
    display: block;

    margin-top: 5px;

    color: #5c6878;

    font-size: 10px;
    font-weight: normal;
}

/* =====================================================
   MINIMAP
===================================================== */

#miniMap {
    position: absolute;

    right: 14px;
    bottom: 14px;

    width: 205px;
    height: 78px;

    background: #172235;

    border: 3px solid #08101d;

    box-shadow: 4px 4px 0 rgba(0,0,0,.4);

    z-index: 30;
}

#miniCanvas {
    width: 100%;
    height: 100%;
}

/* =====================================================
   CONTROLS
===================================================== */

#controls {
    position: absolute;

    left: 14px;
    bottom: 14px;

    z-index: 30;

    background: #172235;
    color: white;

    border: 3px solid #08101d;

    box-shadow: 4px 4px 0 rgba(0,0,0,.4);

    padding: 8px 11px;

    font-size: 11px;
}

/* =====================================================
   OVERLAYS
===================================================== */

.overlay {
    position: absolute;

    inset: 0;

    z-index: 200;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #101827;

    color: white;

    text-align: center;
}

.panel {
    width: 760px;
    max-width: 90%;
}

.panel h1 {
    font-size: 48px;

    margin-bottom: 8px;

    text-shadow: 5px 5px 0 #000;
}

.panel h2 {
    color: #ffd84d;

    margin-bottom: 20px;
}

.panel p {
    color: #dce6f5;

    line-height: 1.6;

    margin-bottom: 12px;
}

.startButton {
    margin-top: 12px;

    padding: 14px 30px;

    border: 4px solid #101010;

    background: #39c85b;
    color: white;

    font-size: 18px;
    font-weight: bold;

    cursor: pointer;

    box-shadow: 5px 5px 0 #000;
}

.startButton:hover {
    background: #51df70;
}

.hidden {
    display: none !important;
}

/* =====================================================
   MOBILE
===================================================== */

@media(max-width:700px) {

    #hud {
        transform: scale(.72);
        transform-origin: top left;
        width: 140%;
    }

    #controls {
        display: none;
    }

    #miniMap {
        transform: scale(.75);
        transform-origin: bottom right;
    }

    #dialog {
        bottom: 4px;
    }

    #choices {
        grid-template-columns: 1fr;
    }

    #customerSpeech {
        font-size: 13px;
    }
}
</style>
</head>

